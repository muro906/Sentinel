# Sentinel Environment Variables
# Copy this file to .env and fill in your actual values

# ── LLM providers (first key present wins; rest are fallbacks) ────────────────

# Google Gemini Flash — FREE tier at aistudio.google.com/apikey
# 15 req/min, 1M tokens/day — ideal for demos
GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude Haiku — https://console.anthropic.com/ (paid)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Groq Llama — https://console.groq.com/ (free, fast, used as fallback)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# PostgreSQL Database Password
POSTGRES_PASSWORD=your_database_password_here

# JWT Secret Key for Dashboard Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here

# Kafka Bootstrap Servers (optional, defaults to localhost:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional: Override default settings
# MIN_ANOMALY_SCORE=0.5
# NUM_PLANS=3
# LLM_TEMPERATURE=0.7
# APPROVAL_TIMEOUT=600
